{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.1/.schema/devbox.schema.json",

  "packages": {
    "cmake":            {"version": "4.1.2"},
    "pkg-config":       {"version": "0.29.2"},
    "git":              {"version": "2.53.0"},
    "boost":            {"version": "1.89.0", "outputs": ["out", "dev"]},
    "tbb_2021":         {"version": "2021.12.0", "outputs": ["out", "dev"]},
    "eigen":            {"version": "3.4.1"},
    "cgal":             {"version": "6.1.1"},
    "gmp":              {"version": "6.3.0", "outputs": ["out", "dev"]},
    "mpfr":             {"version": "4.2.2", "outputs": ["out", "dev"]},
    "libpng":           {"version": "1.6.56", "outputs": ["out", "dev"]},
    "zlib":             {"version": "1.3.2", "outputs": ["out", "dev"]},
    "expat":            {"version": "2.7.5", "outputs": ["out", "dev"]},
    "openssl":          {"version": "3.6.0", "outputs": ["out", "dev"]},
    "opencv":           {"version": "4.13.0"},
    "nlopt":            {"version": "2.10.1"},
    "qhull":            {"version": "2020.2"},
    "cereal":           {"version": "1.3.2"},
    "opencascade-occt": {"version": "7.9.3"},
    "freetype":         {"version": "2.14.2", "outputs": ["out", "dev"]},
    "jsonnet":          "latest"
  },

  "env": {
    "LIBNOISE_PREFIX":   "$DEVBOX_PROJECT_ROOT/.devbox/state/libnoise",
    "CMAKE_PREFIX_PATH": "$DEVBOX_PROJECT_ROOT/.devbox/state/libnoise",
    "PKG_CONFIG_PATH":   "$DEVBOX_PROJECT_ROOT/.devbox/state/libnoise/lib/pkgconfig:$PKG_CONFIG_PATH"
  },

  "shell": {
    "init_hook": ["bash $DEVBOX_PROJECT_ROOT/scripts/devbox-libnoise.sh"],
    "scripts": {
      "configure": "cmake -S . -B build -DCMAKE_PREFIX_PATH=\"$LIBNOISE_PREFIX\"",
      "build":     "cmake --build build --parallel",
      "test":      "cargo test"
    }
  }
}
